"""Pure data contracts for Section 6.2 naturalistic ablations.

This module deliberately contains no model or intervention code.  It pins the
frozen Section 5 rotations, verifies the R1 behavioral handoff, constructs the
pre-intervention analysis membership, and checks rotation artifacts before a
GPU-backed runner loads a model.
"""

from __future__ import annotations

import csv
import json
from collections import defaultdict
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable, Mapping, Sequence

from .section62_data import FULL_CELL_ORDER, RHO_SAME_DONOR, sha256_file


R1_SCHEMA_VERSION = 1
R1_RUN_TYPE = "section62_behavioral_gate"
R2_ANALYSIS_SCOPE = "baseline_correct_secondary_only"
FULL_SQUARE_ANALYSIS_SCOPE = "full_square_mtf_primary"
ANALYSIS_POPULATIONS = frozenset({"baseline-correct", "full-square"})
DEFAULT_MIN_BASELINE_CORRECT_PER_CELL = 50
EXPECTED_R1_INPUT_ROWS = {
    "square_valid": 620,
    "all_u": 404,
}

EXPECTED_LABEL_BY_STRATUM = {
    "square_valid": {
        "++": "T",
        "-+": "F",
        "+-": "F",
        "--": "T",
    },
    "all_u": {cell: "U" for cell in FULL_CELL_ORDER},
}
PORTABILITY_PAIR_CELLS = {
    "negation_count_parity": ("++", "--"),
    "negation_position": ("-+", "+-"),
}
PERMITTED_INPUT_SITES = frozenset({"claim_final", "answer_token"})


class Section62AblationContractError(ValueError):
    """Raised when an R2 handoff or frozen artifact violates its contract."""


@dataclass(frozen=True)
class FrozenSiteProfile:
    """A preregistered pair of rho and m rotations at one execution site."""

    model_name: str
    model_key: str
    reported_site: str
    layer: int
    rank: int
    hidden_size: int
    rho_rotation_dir: str
    m_rotation_dir: str
    rho_metadata_site: str
    m_metadata_site: str


